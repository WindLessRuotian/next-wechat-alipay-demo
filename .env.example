# ─────────────────────────────────────────────────────────────────────────────
# Copy to .env.local:  cp .env.example .env.local
# In mock mode (default) nothing below the "App" block needs a value.
# NEVER commit real values — .env* (except this file) and certs/ are git-ignored.
# ─────────────────────────────────────────────────────────────────────────────

# ── App ──────────────────────────────────────────────────────────────────────
# Public base URL of this app; use your tunnel URL (https://xxxx.ngrok-free.app) for sandbox/live.
APP_URL=http://localhost:3000
# Secret for HMAC of session tokens and OAuth state cookies; >= 32 random chars (openssl rand -base64 48).
SESSION_SECRET=replace-with-32-plus-random-chars-0000000000
# SQLite database file (migrations are applied automatically on first access).
DATABASE_URL=file:./dev.db
# Default mode for both providers: mock | sandbox | live.
PAYMENT_MODE=mock
# Optional per-provider override of PAYMENT_MODE (e.g. ALIPAY_MODE=sandbox with WeChat still mocked).
WECHAT_MODE=
# Optional per-provider override of PAYMENT_MODE.
ALIPAY_MODE=
# Minutes after which an unpaid order is closed at the provider and locally.
ORDER_TTL_MINUTES=15

# ── WeChat Login (Open Platform "website application") ───────────────────────
# AppID of the verified website application on open.weixin.qq.com.
WECHAT_APP_ID=
# AppSecret of that application (server-side only).
WECHAT_APP_SECRET=

# ── WeChat Pay (API v3, Native) ─────────────────────────────────────────────
# Merchant ID (商户号).
WECHAT_PAY_MCH_ID=
# AppID bound to the merchant ID that the payment is made under.
WECHAT_PAY_APP_ID=
# APIv3 key set in the merchant platform — exactly 32 characters.
WECHAT_PAY_API_V3_KEY=
# Serial number of the merchant API certificate (商户API证书序列号).
WECHAT_PAY_CERT_SERIAL_NO=
# Path to the merchant API private key (apiclient_key.pem); keep it under certs/.
WECHAT_PAY_PRIVATE_KEY_PATH=./certs/apiclient_key.pem
# Path to the WeChat Pay public key (微信支付公钥) used to verify responses & notifications.
WECHAT_PAY_PLATFORM_PUBLIC_KEY_PATH=./certs/wechatpay_public_key.pem
# ID of that public key as sent in the Wechatpay-Serial header, e.g. PUB_KEY_ID_0112345678901234567890.
WECHAT_PAY_PLATFORM_PUBLIC_KEY_ID=
# Public URL WeChat Pay POSTs payment notifications to (must be https and reachable from the internet).
WECHAT_PAY_NOTIFY_URL=${APP_URL}/api/pay/wechat/notify

# ── Alipay (Login + Payment) ────────────────────────────────────────────────
# App ID of your Alipay (sandbox) application.
ALIPAY_APP_ID=
# App private key (应用私钥), PKCS#8 or PKCS#1, bare base64 or PEM; use \n for line breaks if PEM.
ALIPAY_PRIVATE_KEY=
# Alipay public key (支付宝公钥 — NOT your app public key), used to verify responses & notifications.
ALIPAY_PUBLIC_KEY=
# Optional: your seller/partner ID (2088…); if set, notifications with another seller_id are rejected.
ALIPAY_SELLER_ID=
# OpenAPI gateway; sandbox shown, live is https://openapi.alipay.com/gateway.do
ALIPAY_GATEWAY=https://openapi-sandbox.dl.alipaydev.com/gateway.do
# User authorisation page; live is https://openauth.alipay.com/oauth2/publicAppAuthorize.htm
ALIPAY_AUTH_URL=https://openauth-sandbox.dl.alipaydev.com/oauth2/publicAppAuthorize.htm
# Public URL Alipay POSTs async notifications to (must be reachable from the internet).
ALIPAY_NOTIFY_URL=${APP_URL}/api/pay/alipay/notify
# Where the browser returns after paying (display only — never used to mark an order paid).
ALIPAY_RETURN_URL=${APP_URL}/orders
